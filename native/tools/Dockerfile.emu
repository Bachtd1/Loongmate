FROM --platform=linux/arm64 ubuntu:22.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3 fonts-dejavu-core libglib2.0-0 libgraphite2-3 libbrotli1 libbz2-1.0 zlib1g libpng16-16 libfreetype6 ca-certificates && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /fonts && cp /usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf /fonts/font.ttf
